                <xsd:documentation source="CalculationsAndRules">If Pv09_PV_MinimumSize GT 0 this field is required 
If SUM ALL (Bat04_BatteryCapacityMinPerArea) LT 10 
   result = 0
Else
   result = SUM ALL (Bat04_BatteryCapacityMinPerArea where Pv02_ConditionedFloorArea GTE 5000 And If A02_ClimateZone == 1, where Bat01_WholeBuildingOccupancy != OfficeBuilding Or SchoolBuilding Or Warehouse)
   If one or more Bat04_BatteryCapacityMinPerArea is not included because Pv02_ConditionedFloorArea LT 5000
      D03_ExceptionalConditionMessageCCSABE += BatteryExempt5000SF
   If one or more Bat04_BatteryCapacityMinPerArea is not included because A02_ClimateZone == 1 And Bat01_WholeBuildingOccupancy == OfficeBuilding Or SchoolBuilding Or Warehouse
