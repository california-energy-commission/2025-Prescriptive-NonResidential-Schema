                        <xsd:documentation source="AdditionalRequirements">CONSTRUCTION DOCUMENTS SHALL INDICATE RESERVED LOCATIONS FOR INVERTERS AND METERING EQUIPMENT AND A PATHWAY RESERVED FOR CONDUIT ROUTING FROM SOLAR ZONE TO POINT OF CONNECTION WITH ELECTIRCAL SERVICE, OR A PATHWAY FOR ROUTING OF PLUMBING FROM SOLAR ZONE TO WATER-HEATING SYSTEM.</xsd:documentation>
                        <xsd:documentation source="CalculationsAndRules">If B01a_IsProjectAllocatedSolarZone == true 
result = true and FieldText and AdditionalRequirements static text is displayed in the report
Else
result = false and nothing is displayed in the report
End If</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DUMM110_10d_MeasureApplies" type="comp:MeasureApplies">
                      <xsd:annotation>
                        <xsd:documentation source="FieldText">
                          <d:b><d:t24refnolink/>110.10(d) </d:b>
                        </xsd:documentation>
                        <xsd:documentation source="AdditionalRequirements">A COPY OF THE CONSTRUCTION DOCUMENTS INDATING INFORMATION FROM 
                                       <d:t24refnolink/>110.10(b) AND (c) MUST BE PROVIDED TO THE OCCUPANT.</xsd:documentation>
                        <xsd:documentation source="CalculationsAndRules">If B01a_IsProjectAllocatedSolarZone == true 
result = true and FieldText and AdditionalRequirements static text is displayed in the report
Else
result = false and nothing is displayed in the report
End If</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Footer" type="comp:FooterNRCC"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="Report" type="xsd:base64Binary" minOccurs="0"/>
        <xsd:element name="ReportMMB" type="xsd:base64Binary" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="revision" use="required" type="xsd:string" fixed="rev 20250101"/>
      <xsd:attribute name="doc" use="required" type="comp:ComplianceDocumentTagNR" fixed="NRCCSABE"/>
    </xsd:complexType>
