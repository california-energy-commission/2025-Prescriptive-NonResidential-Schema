                          <xsd:annotation>
                            <xsd:documentation source="FieldText">Roof Area <d:lt/> 70% Solar Access<d:sup>2</d:sup> (ft<d:sup>2</d:sup>)</xsd:documentation>
                            <xsd:documentation source="CalculationsAndRules">User input area</xsd:documentation>
                          </xsd:annotation>
