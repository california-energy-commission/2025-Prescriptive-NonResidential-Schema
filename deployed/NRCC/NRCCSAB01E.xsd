                            <xsd:documentation source="CalculationsAndRules">User input</xsd:documentation>
                          </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Pv10_RoofAreaOccupied" type="comp:RoofAreaOccupied">
                          <xsd:annotation>
                            <xsd:documentation source="FieldText">Roof area occupied, no structural support, not available due to other state codes, <d:lt/> 80 contiguous (ft<d:sup>2</d:sup>)</xsd:documentation>
                            <xsd:documentation source="CalculationsAndRules">User input</xsd:documentation>
                          </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Pv11_SolarAccessRoofArea" type="comp:SolarAccessRoofArea">
                          <xsd:annotation>
                            <xsd:documentation source="FieldText">Solar Access Roof Area (SARA) (ft<d:sup>2</d:sup>)</xsd:documentation>
                            <xsd:documentation source="CalculationsAndRules">Calculated field:
result = Pv07_RoofArea - Pv08_RoofArea70PercentSolarAccess - Pv10_RoofAreaOccupied</xsd:documentation>
                          </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Pv12_PV_MinSizeSARA" type="comp:PV_MinSizeSARA">
                          <xsd:annotation>
                            <xsd:documentation source="FieldText">Min Capacity of PV System Required (kWdc)</xsd:documentation>
                            <xsd:documentation source="CalculationsAndRules">Calculated field:
If Pv06_RoofSlope == LT212
Result = ((Pv11_SolarAccessRoofArea x 14)/1000)

Else If Pv06_RoofSlope == GTE212
Result = ((Pv11_SolarAccessRoofArea x 18)/1000)
                                       </xsd:documentation>
                          </xsd:annotation>
                        </xsd:element>
                      </xsd:sequence>
                    </xsd:complexType>
