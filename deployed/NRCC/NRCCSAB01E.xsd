                          <xsd:annotation>
                            <xsd:documentation source="FieldText">Min Rated Usable Energy Capacity of BESS Required (kWh)</xsd:documentation>
                            <xsd:documentation source="CalculationsAndRules">Calculated field: 
If Pv09_PV_MinimumSize = Sum All (Pv04_PV_MinSizeEquation)
  result = (Pv02_ConditionedFloorArea x FactorB) / (1000 * Bat03_ChargeDischargeEfficiency ^ 0.5)
Else If Pv09_PV_MinimumSize == Sum All (Pv12_PV_MinSizeSARA)
  result = (Pv02_ConditionedFloorArea x FactorB) / (1000 * Bat03_ChargeDischargeEfficiency ^ 0.5) * ((Sum All (Pv12_PV_MinSizeSARA)) / (Sum All (Pv04_PV_MinSizeEquation))

