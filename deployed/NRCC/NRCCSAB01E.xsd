            <xsd:element name="Pv09_PV_MinimumSize" type="comp:PV_MinimumSize">
              <xsd:annotation>
                <xsd:documentation source="FieldText">
                  <d:b>Total Min Size PV System Required for all Spaces (kWdc):</d:b>
                </xsd:documentation>
                <xsd:documentation source="CalculationsAndRules">Calculated field:
If SUM ALL (Pv11_SolarAccessRoofArea)  LT 80 Or LT (0.03 x SUM ALL (Pv02_ConditionedFloorArea))
result = 0
Else If (Sum All (Pv12_PV_MinSizeSARA)) or (Sum All (Pv04_PV_MinSizeEquation)) LT 4
result = 0 
Else If Sum All (Pv04_PV_MinSizeEquation) LT Sum All (Pv12_PV_MinSizeSARA)
result = Sum All (Pv04_PV_MinSizeEquation)
Else
result = Sum All (Pv12_PV_MinSizeSARA)
End If</xsd:documentation>
              </xsd:annotation>
